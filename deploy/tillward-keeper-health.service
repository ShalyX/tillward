[Unit]
Description=Check Tillward keeper heartbeat, accounts, gas and disk
After=tillward-keeper.service

[Service]
Type=oneshot
User=tillward-keeper
Group=tillward-keeper
WorkingDirectory=/opt/tillward-keeper
Environment=KEEPER_STATE_DIR=/var/lib/tillward-keeper
ExecStart=/opt/tillward-keeper/bin/node scripts/keeper-health.mjs
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tillward-keeper
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
UMask=0077
