[Unit]
Description=Tillward Mezo testnet repayment keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tillward-keeper
Group=tillward-keeper
WorkingDirectory=/opt/tillward-keeper
StateDirectory=tillward-keeper
StateDirectoryMode=0700
Environment=KEEPER_STATE_DIR=/var/lib/tillward-keeper
ExecStart=/usr/bin/flock -n /var/lib/tillward-keeper/runner.lock /opt/tillward-keeper/bin/node scripts/keeper.mjs /var/lib/tillward-keeper/wallet.json --all --watch
Restart=on-failure
RestartSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0077
MemoryMax=256M
CPUQuota=20%
LogRateLimitIntervalSec=60s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
